# Backend Environment Variables
# Copy to .env and fill in the actual values

# Database connection (use the APPLICATION user, never root)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mudraflow
DB_APP_USER=mudraflow_app
DB_APP_PASSWORD=your_app_password_here

# JWT secret (any long random string)
JWT_SECRET=change_me_to_a_long_random_string

# JWT token expiry
JWT_EXPIRY=8h

# Server port
PORT=3000

