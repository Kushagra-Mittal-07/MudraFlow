# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mudraflow

# Setup / Migration User (Root or mudraflow_admin)
DB_USER=root
DB_PASSWORD=your_root_password_here

# MudraFlow Application User (Column-level security)
DB_APP_USER=mudraflow_app
DB_APP_PASSWORD=App@Mudra123

# MudraFlow Admin User
DB_ADMIN_USER=mudraflow_admin
DB_ADMIN_PASSWORD=Admin@Mudra123

# Default Demo User Password
DEMO_PASSWORD=Demo@123

